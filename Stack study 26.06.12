#include <stdio.h>
#include <stdlib.h>
#define SIZE 100

#include <stdio.h>
#include <stdlib.h>
#define SIZE 100

typedef struct StackType {
    int arr[SIZE];  // [] 대괄호 사용, int 타입으로 변경
    int top;
} StackType;        // 세미콜론(;) 추가

// 스택 초기화: s가 가리키는 top을 -1로 대입(=)
void init(StackType *s) {  
    s->top = -1; 
}

// 스택이 가득 찼는지 검사 (참이면 1, 거짓이면 0)
int is_full(StackType *s) { 
    return (s->top == SIZE - 1); 
}

// 스택이 비었는지 검사 (참이면 1, 거짓이면 0)
int is_empty(StackType *s) { 
    return (s->top == -1); 
}

int push(StackType *s, int value) {
    if (is_full(s)) { 
        return 0; 
    }
    // arr은 구조체 소속이므로 s->를 반드시 붙여야 하고, 대입(=)을 써야 함
    s->arr[++(s->top)] = value; 
    return 1;
}

int pop(StackType *s) {
    if (is_empty(s)) { 
        return -1; // 빈 스택 예외 처리
    }
    // arr 앞에 s-> 붙이기, 문장 끝에 세미콜론(;) 누락 수정
    return s->arr[(s->top)--]; 
}

void print_stack(StackType *s) {

  if(is_empty(s)) {
    printf("스택이 비어있습니다.");
    return;
  }
  int len = strlen(s)
  for(int i=0; i<len ; i++){
    printf("%c",s[i]);
  }
}

void setup() {
  char *str[SIZE] = {};
  scanf("%c",&str);
  print_stack(&str);
}

