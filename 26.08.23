#include <stdio.h>
#include <stdlib.h>

#define MAX 5

typedef struct Dequeue{
  int front, rear;
  int data[MAX];
} Deque;

void init(Deque *dq){
  dq->front = dq->rear = 0;
}

int is_full(Deque *dq){
  return (dq->rear + 1) % MAX == dq->front;
}

int is_empty(Deque *dq){
  return dq->rear == dq->front;
}

void add_front(Deque *dq,int item){
  if(is_full(dq)){
    printf("error");
    exit(1);
  }
  dq->data[dq->front] = item;
  dq->front = (dq->front -1 + MAX) % MAX;
}

void add_rear(Deque *dq,int item){
  if(is_full(dq)){
    printf("error");
    exit(1);
  }
  dq->rear = (dq->rear + 1) % MAX;
  dq->data[dq->rear] = item;
}

int delet_front(Deque *dq){
  if(is_empty(dq)){
    printf("error");
    exit(1);
  }
  dq->front = (dq->front+1) % MAX;
  return dq->data[dq->front];
}

int delet_rear(Deque *dq){
  if(is_empty(dq)){
    printf("error");
    exit(1);
  }
  int prev = dq->rear;
  dq->rear = (dq->rear - 1 + MAX) % MAX;
  return dq->data[prev];
}

int main (){
  Deque dq;
  init(&dq);

  add_front(&dq,10);
  add_front(&dq,20);
  add_front(&dq,30);

  delet_front(&dq);
}
